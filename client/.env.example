# URL of the Express API (server-side only; also the target of the /api/* rewrite)
API_URL=http://localhost:4000

# Canonical public URL of this site (server-side only: sitemap, robots, metadata)
SITE_URL=http://localhost:3000

# Google OAuth Web client ID for staff sign-in (same value as GOOGLE_CLIENT_ID on the server)
GOOGLE_CLIENT_ID=

# reCAPTCHA v3 site key (secret goes in the server's RECAPTCHA_SECRET). Empty = disabled.
RECAPTCHA_SITE_KEY=

# Google Maps Embed API key (optional; falls back to the keyless embed)
GOOGLE_MAPS_API_KEY=
