# --- Core
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/pmd
# Origins allowed to call the API directly (the Next.js site). Comma-separated.
CLIENT_ORIGINS=http://localhost:3000
# Public URL of this API (used for legacy /media URLs before Cloudinary migration)
PUBLIC_API_URL=http://localhost:4000

# --- Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=
# 32 bytes as 64 hex chars. Encrypts ID and bank account numbers at rest. Never change it once data exists.
ENCRYPTION_KEY=

# --- Google sign-in (admin area). Same OAuth Web client ID as NEXT_PUBLIC_GOOGLE_CLIENT_ID in the client.
GOOGLE_CLIENT_ID=
# Google accounts allowed into /admin. Comma-separated.
ADMIN_EMAILS=admin@pmdinvestment.co.za

# --- reCAPTCHA v3 (public forms). Leave empty to skip verification locally.
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5

# --- Gmail (form notifications). Use OAuth2 (preferred) OR an app password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
NOTIFY_EMAILS=admin@pmdinvestment.co.za

# --- Cloudinary (cloudinary://<api_key>:<api_secret>@<cloud_name>)
CLOUDINARY_URL=
CLOUDINARY_FOLDER=pmd
