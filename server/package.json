{
  "name": "pmd-server",
  "version": "1.0.0",
  "private": true,
  "description": "PMD Investment Academy API — Express, MongoDB, Google, Cloudinary",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "dev:memory": "node scripts/dev-memory.js",
    "test": "node --test test/*.test.js",
    "vendor:sanitize-html": "node scripts/vendor-sanitize-html.js"
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "google-auth-library": "^11.3.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.4.0",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.2"
  }
}
